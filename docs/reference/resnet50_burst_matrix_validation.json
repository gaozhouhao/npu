    "source": "#!/usr/bin/env python3\n\"\"\"Independent nonzero RGB/odd-stride Conv Burst validation fixture.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,sys\nroot=Path.cwd();out=root/'build/resnet50-burst-matrix/unaligned-model';check=root/'build/resnet50-burst-matrix/unaligned-check'\nfor path in (out,check):\n    if path.exists() or path.is_symlink():raise SystemExit('Refusing existing directory: '+str(path))\nsys.path.insert(0,str(root/'compiler'));sys.path.insert(0,str(root/'scripts/model'))\nfrom graph_compiler import compile_graph,write_package,benchmark_quantization\nfrom target import hardware_defaults\nfrom run_graph_model import prepare,read_dump\nclass SeededGraph(dict):\n    def load_weights(self,node):\n        n,k=node['weights']['shape']\n        return [(((channel*3+index*2)%11)-5)*(channel%4+1)*0.0075 for channel in range(n) for index in range(k)]\n    def load_tensor(self,name):\n        size=4 if name=='conv.b' else 1001\n        return [(i%9-4)*0.013 for i in range(size)]\nnodes=[dict(name='conv',op='Conv',inputs=['input'],output='conv',shape=[6,7,4],attrs=dict(kernel=[7,7],strides=[2,2],pads=[3,3,3,3]),weights=dict(name='conv.w',shape=[4,147]),bias=dict(name='conv.b',shape=[4])),\n       dict(name='pool',op='MaxPool',inputs=['conv'],output='pool',shape=[3,4,4],attrs=dict(kernel=[3,3],strides=[2,2],pads=[1,1,1,1])),\n       dict(name='gap',op='GlobalAveragePool',inputs=['pool'],output='gap',shape=[1,1,4]),\n       dict(name='fc',op='FullyConnected',inputs=['gap'],output='logits',shape=[1001],weights=dict(name='fc.w',shape=[1001,4]),bias=dict(name='fc.b',shape=[1001]))]\ngraph=SeededGraph(input=dict(name='input',shape=[11,13,3]),nodes=nodes,output='logits',source='RGB11x13x3 odd-stride historical Burst compatibility validation')\nprofile=benchmark_quantization(graph);cfg=hardware_defaults();cfg.update(ddr_capacity_bytes=1024*1024,ddr_base=0,alignment_bytes=8,activation_layout='HWC')\nseed=8;values=[]\nfor i in range(11*13*3):\n    seed=(1664525*seed+1013904223)&0xffffffff;value=((seed>>24)%255)-127;values.append((value if value else 1)&255)\ninputs=bytes(values);plan,image,descriptors=compile_graph(graph,cfg,profile,inputs,benchmark_only=True);write_package(str(out),plan,image,descriptors);reference=prepare(out,check)\nassert reference['status']=='PASS' and reference['descriptor_count']==4\nassert (plan['commands'][0]['m'],plan['commands'][0]['n'],plan['commands'][0]['k'])==(42,4,147)\nassert plan['commands'][0]['flags']&8 and plan['commands'][-1]['flags']&8\noutputs=[]\nfor layer in reference['layers']:\n    raw=read_dump(layer['expected_hex'])[:layer['logical_bytes']];vals=[b if b<128 else b-256 for b in raw]\n    assert len(set(vals))>1 and any(vals),(layer['index'],vals)\n    outputs.append(dict(index=layer['index'],bytes=len(raw),minimum=min(vals),maximum=max(vals),unique_values=len(set(vals)),nonzero_values=sum(v!=0 for v in vals),sha256=hashlib.sha256(raw).hexdigest()))\nsummary=dict(status='PASS',purpose='integer_performance_and_RGB_alignment_validation',calibrated=False,dataset_accuracy_measured=False,input_generator='LCG seed8; signed nonzero INT8',input_shape=[11,13,3],input_physical_row_stride_bytes=39,input_sha256=hashlib.sha256(inputs).hexdigest(),descriptor_count=4,image_bytes=len(image),conv_shape=dict(m=42,n=4,k=147,kernel=[7,7],strides=[2,2],pads=[3,3,3,3]),pool_shape=[3,4,4],expected_sha256=reference['expected_sha256'],package_sha256=reference['package_sha256'],nodes=[dict(index=i,op=n['op'],shape=n['shape'],flags=plan['commands'][i]['flags']) for i,n in enumerate(nodes)],reference_output_statistics=outputs,generator_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())\n(out/'generation.json').write_text(json.dumps(summary,indent=2,sort_keys=True)+'\\n');print(json.dumps(summary,indent=2,sort_keys=True))\n"
